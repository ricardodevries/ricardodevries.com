---
import { Monitor, Moon, Sun } from "@lucide/astro";
---

<div data-toggle-picker class="theme-selector">
  <span class="sr-only">Toggle theme helpers</span>

  <ul class="theme-list flex flex-center">
    <li class="system">
      <button type="button" data-toggle-theme="system" aria-label="Use system theme" title="System theme">
        <Monitor size={16} />
      </button>
    </li>
    <li class="light">
      <button type="button" data-toggle-theme="light" aria-label="Use light theme">
        <Sun size={16} />
      </button>
    </li>
    <li class="dark">
      <button type="button" data-toggle-theme="dark" aria-label="Use dark theme">
        <Moon size={16} />
      </button>
    </li>
  </ul>
</div>
