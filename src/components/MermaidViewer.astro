---
import "../assets/css/mermaid.scss";
---

<dialog id="mermaid-viewer" class="mermaid-viewer" aria-labelledby="mermaid-viewer-title">
  <header class="mermaid-viewer__header">
    <h2 id="mermaid-viewer-title">Diagram</h2>
    <button type="button" class="mermaid-viewer__close" autofocus>Close</button>
  </header>
  <div class="content mermaid-viewer__content"></div>
</dialog>

<script>
  let observer: MutationObserver | undefined;
  let closeViewer: (() => void) | undefined;

  function initDiagrams() {
    observer?.disconnect();

    const dialog = document.querySelector<HTMLDialogElement>(".mermaid-viewer");
    const viewerContent = dialog?.querySelector<HTMLElement>(".mermaid-viewer__content");
    const viewerTitle = dialog?.querySelector<HTMLElement>("#mermaid-viewer-title");

    if (!dialog || !viewerContent || !viewerTitle) {
      return;
    }

    let restorePanel: (() => void) | undefined;

    closeViewer = () => dialog.close();
    dialog.querySelector(".mermaid-viewer__close")?.addEventListener("click", closeViewer);
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        const bounds = dialog.getBoundingClientRect();

        if (event.clientX < bounds.left || event.clientX > bounds.right ||
            event.clientY < bounds.top || event.clientY > bounds.bottom) {
          dialog.close();
        }
      }
    });
    dialog.addEventListener("close", () => {
      restorePanel?.();
      restorePanel = undefined;
      document.documentElement.classList.remove("mermaid-viewer-open");
    });

    function enhanceDiagrams() {
      document.querySelectorAll<HTMLPreElement>("pre.mermaid").forEach((diagram) => {
        if (diagram.dataset.enhanced || !diagram.querySelector("svg")) {
          return;
        }

        diagram.dataset.enhanced = "true";
        const panel = document.createElement("div");
        panel.className = "mermaid-panel";
        diagram.before(panel);
        panel.append(diagram);

        const footer = document.createElement("div");
        footer.className = "mermaid-panel__footer";
        const expand = document.createElement("button");
        expand.type = "button";
        expand.className = "mermaid-panel__expand";
        expand.textContent = "Expand diagram ↗";
        expand.setAttribute("aria-haspopup", "dialog");
        expand.setAttribute("aria-controls", "mermaid-viewer");
        expand.setAttribute("aria-label", `Expand ${diagram.querySelector("svg title")?.textContent || "diagram"}`);
        const credit = document.createElement("small");
        credit.className = "mermaid-panel__credit";
        credit.textContent = "© ricardodevries.com";
        footer.append(expand, credit);
        panel.append(footer);

        function openViewer() {
          if (!dialog || !viewerContent || !viewerTitle || dialog.open) {
            return;
          }

          const title = diagram.querySelector("svg title")?.textContent || "Diagram";
          viewerTitle.textContent = title;
          const placeholder = document.createElement("div");
          placeholder.style.height = `${panel.getBoundingClientRect().height}px`;
          panel.replaceWith(placeholder);
          // Move the live diagram so SVG IDs and accessible labels stay unique.
          viewerContent.append(panel);
          restorePanel = () => {
            placeholder.replaceWith(panel);
            expand.focus({ preventScroll: true });
          };
          document.documentElement.classList.add("mermaid-viewer-open");
          dialog.showModal();
        }

        expand.addEventListener("click", openViewer);
        diagram.addEventListener("click", (event) => {
          if (event.target instanceof Element && !event.target.closest("a")) {
            openViewer();
          }
        });
        // The scrollable region is keyboard accessible on small screens.
        diagram.tabIndex = 0;
        diagram.setAttribute("role", "region");
        diagram.setAttribute("aria-label", diagram.querySelector("svg title")?.textContent || "Diagram");
        diagram.addEventListener("keydown", (event) => {
          if (event.target === diagram && (event.key === "Enter" || event.key === " ")) {
            event.preventDefault();
            openViewer();
          }
        });
      });
    }

    enhanceDiagrams();
    observer = new MutationObserver(enhanceDiagrams);
    observer.observe(document.body, { childList: true, subtree: true });
  }

  document.addEventListener("astro:page-load", initDiagrams);
  document.addEventListener("astro:before-swap", () => {
    closeViewer?.();
    observer?.disconnect();
  });
</script>
